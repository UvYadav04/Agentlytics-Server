# Copy this file to Server/shared/.env and fill in real values.
# api_service and worker_service both load this file (in addition to their
# own .env, if present) via shared.config.get_settings().

# --- MongoDB (Atlas) ---
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net
MONGO_DB_NAME=data_analyzer

# --- Redis (Upstash for prod, local docker for dev) ---
REDIS_URL=redis://localhost:6379/0

# --- AWS S3 ---
AWS_ACCESS_KEY=
AWS_ACCESS_SECRET=
AWS_REGION=us-east-1
AWS_BUCKET=data-analyzer

# --- Google OAuth ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Auth / JWT ---
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=43200

# --- CORS ---
FRONTEND_ORIGIN=http://localhost:3000
# Comma-separated list of origins the browser is allowed to call this API from (api_service/
# main.py). Credentialed (cookie) requests can't use "*", so every origin the client is served
# from - dev and prod - needs to be listed explicitly. Defaults to the two below if left unset.
CORS_ORIGINS=http://localhost:3000,https://agentlytics.duckdns.org

# --- Email/password auth (shared/email.py) ---
# How long a signup's verification link stays valid before /auth/verify-email rejects it and
# the user has to request a new one via /auth/resend-verification.
EMAIL_VERIFICATION_TOKEN_EXPIRE_HOURS=24

# --- SMTP (shared/email.py) - verification links, temporary passwords, password-changed
# notices. Defaults to Brevo's own naming (SMTP_SERVER/SMTP_PORT/SMTP_LOGIN/SMTP_KEY, from the
# Brevo dashboard's SMTP & API settings) - Brevo's SMTP relay is smtp-relay.brevo.com:587,
# SMTP_LOGIN is the xxxxx@smtp-brevo.com address Brevo generates, SMTP_KEY is the SMTP key
# (not your Brevo account password). Any other provider that exposes SMTP credentials also works
# unchanged (Gmail/Google Workspace with an App Password, Amazon SES SMTP, SendGrid SMTP relay,
# Mailgun, Resend, Postmark, ...) - shared/email.py also accepts the older SMTP_HOST/
# SMTP_USERNAME/SMTP_PASSWORD names as a fallback if that's what you're already using. Leaving
# SMTP_SERVER blank just logs a warning and skips sending - useful for local dev, but
# signup/forgot-password won't actually deliver anything until this is set.
SMTP_SERVER=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_LOGIN=
SMTP_KEY=
# true for STARTTLS on the usual submission port (587) - almost every provider above. Set to
# false only if your provider's SMTP is unencrypted (rare) or you're pointing at a local
# mail-catcher like Mailhog/Mailpit for testing.
SMTP_USE_TLS=true
# What shows up in the "From" header - has to be a sender verified in your provider's dashboard
# (for Brevo: Senders & IP > Senders), NOT necessarily the same address as SMTP_LOGIN, which
# only authenticates the connection. Falls back to dineshnirban01@gmail.com if left blank.
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Agentlytics

# --- Intent routing (shared/intent_router.py) ---
# Hybrid classifier: embedding similarity first, LLM fallback only when unsure. Reuses
# DEEPINFRA_API_KEY above for both tiers (embeddings + the LLM fallback's INTENT_CLASSIFIER_MODEL,
# see shared/intent_classifier.py). Leaving DEEPINFRA_API_KEY unset disables the embedding tier
# entirely - every query then goes straight to the LLM classifier, same as before this feature.
INTENT_EMBEDDING_MODEL=BAAI/bge-base-en-v1.5
INTENT_EMBEDDING_TIMEOUT=5.0
# Path to the JSON file of representative example phrases per intent - edit that file to improve
# routing (add more phrases), no code change or retraining needed. Relative paths are resolved
# from shared/ itself; leave unset to use shared/intent_examples.json.
INTENT_EXAMPLES_PATH=
# Below this cosine similarity, the embedding tier is never trusted regardless of margin.
INTENT_SIMILARITY_THRESHOLD=0.60
# Minimum gap between the winning intent's score and the runner-up intent's score - a small
# margin means the query is genuinely ambiguous between two intents, even if the top score
# itself is high, so it still falls back to the LLM classifier.
INTENT_MARGIN_THRESHOLD=0.05
# LLM fallback model (only called when the embedding tier isn't confident) - see
# shared/intent_classifier.py.
INTENT_CLASSIFIER_MODEL=Qwen/Qwen3.5-9B
# Semantic cache (shared/semantic_cache.py) in front of the LLM fallback call above - a
# semantically similar query that already went through the LLM fallback tier once skips the
# DeepInfra round trip on repeat. Reuses REDIS_URL and DEEPINFRA_API_KEY above; set to false to
# always call the LLM (e.g. while debugging classifier changes).
INTENT_CACHE_ENABLED=true

# --- Query router shadow classifier (shared/query_router.py) ---
# Runs alongside the main intent classifier purely for evaluation/logging
# (see chats.py) - never blocks or changes the actual response, so these are
# safe to leave at their defaults.
QUERY_ROUTER_FUZZY_THRESHOLD=0.84
QUERY_ROUTER_HF_THRESHOLD=0.80
QUERY_ROUTER_HF_ENABLED=false
QUERY_ROUTER_MAX_WORDS=6

# --- Usage limits (free tier) ---
FREE_TIER_MESSAGES=20
FREE_TIER_MESSAGES_PER_CHAT=8
FREE_TIER_CHARTS=3
FREE_TIER_REPORTS=2
FREE_TIER_CHATS=2
FREE_TIER_WORKSPACES=2

# --- Observability ---
# In docker-compose.yml these are already set via `environment:` (pointing
# at the loki/langfuse-web services on the compose network) - only fill
# these in here if running api_service/worker_service as bare processes
# outside docker compose.
LOG_LEVEL=INFO
ENVIRONMENT=development
# http://<host>:3100/loki/api/v1/push - leave blank to disable Loki shipping
# and log to console only (see shared/logging_config.py).
LOKI_URL=

# Self-hosted Langfuse, api_service side (see docker-compose.yml + root
# .env.example for the Langfuse stack itself). The actual per-LLM-call
# tracing reads its OWN copy of these two keys from
# Server/analyzerEngine/.env.example instead (see
# llm_provider/langfuse_wrapper.py's docstring for why) - this copy is for
# shared/observability.py's get_langfuse_client(), currently unused but
# available if api_service ever wants to push something to Langfuse
# directly (e.g. logging user thumbs-up/down feedback as a Langfuse score).
# Same values either way - either the ones you chose in the root .env's
# LANGFUSE_INIT_PROJECT_PUBLIC_KEY/_SECRET_KEY (auto-provisioned on first
# boot), or the ones the Langfuse UI generates if you signed up manually
# instead. One project, same two keys, copied into both files.
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
