# Copy this file to `.env` (same directory as docker-compose.yml) and fill
# in real values. docker compose auto-loads `.env` next to the compose file
# for ${VAR} substitution.
#
# Two unrelated groups of settings live in this one file:
#   1. Image tagging (used by docker-compose.yml directly - local builds,
#      CI push, and the EC2 pull all read these).
#   2. Observability stack secrets (used by docker-compose.observability.yml
#      only - Langfuse's Postgres/ClickHouse/MinIO/Redis + Grafana).
# App secrets (Mongo, JWT, OAuth, LLM provider keys, ...) still live in
# shared/.env and analyzerEngine/.env - unrelated to this file.
#
# Generate the three Langfuse crypto values with:
#   openssl rand -hex 32   -> NEXTAUTH_SECRET
#   openssl rand -hex 16   -> SALT
#   openssl rand -hex 32   -> ENCRYPTION_KEY

# --- Image tagging (Docker Hub) ---
# Your Docker Hub username/org - images build and push as
# ${DOCKERHUB_USERNAME}/data-analyzer-api and .../data-analyzer-worker.
DOCKERHUB_USERNAME=CHANGEME_your_dockerhub_username
# Which tag to build/pull. CI overrides this per-run (see
# .github/workflows/deploy.yml) - leave as `latest` for local dev.
IMAGE_TAG=latest

# --- Langfuse: Postgres ---
POSTGRES_VERSION=17
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGEME_postgres_password
POSTGRES_DB=postgres

# --- Langfuse: ClickHouse (trace/event storage) ---
CLICKHOUSE_USER=clickhouse
CLICKHOUSE_PASSWORD=CHANGEME_clickhouse_password

# --- Langfuse: MinIO (S3-compatible blob storage for media/exports) ---
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=CHANGEME_minio_password

# --- Langfuse: internal queue Redis (separate from the app's own redis) ---
REDIS_AUTH=CHANGEME_langfuse_redis_password

# --- Langfuse: app secrets ---
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=CHANGEME_run_openssl_rand_-hex_32
SALT=CHANGEME_run_openssl_rand_-hex_16
ENCRYPTION_KEY=CHANGEME_run_openssl_rand_-hex_32
TELEMETRY_ENABLED=true

# --- Langfuse: auto-provisioning on first boot (recommended) ---
# Langfuse doesn't generate these keys server-side - YOU pick them here,
# and Langfuse creates the org/project/user with these exact values the
# first time langfuse-web starts. That sidesteps the chicken-and-egg
# problem of "the app needs LANGFUSE_PUBLIC_KEY/SECRET_KEY, but those only
# exist after you've signed up through the UI, which needs the stack
# running first" - fill these in now and it just works from `docker compose
# up`, no manual signup step.
#
# ALL of these are required together for a project+keys to be created (see
# https://langfuse.com/self-hosting/administration/headless-initialization) -
# org id/name, project id/name, the two keys, AND the initial user's
# email/password. Leave the whole block blank instead if you'd rather sign
# up through the UI manually and generate keys from there.
#
# IMPORTANT: after filling these in, copy LANGFUSE_INIT_PROJECT_PUBLIC_KEY
# and LANGFUSE_INIT_PROJECT_SECRET_KEY's values (unchanged) into
# analyzerEngine/.env as LANGFUSE_PUBLIC_KEY / LANGFUSE_SECRET_KEY - that's
# the file llm_provider/langfuse_wrapper.py actually reads to authenticate
# the LLM-call tracing. Don't double-quote any of these values (docker
# compose passes quotes through literally).
LANGFUSE_INIT_ORG_ID=data-analyzer-org
LANGFUSE_INIT_ORG_NAME=Data Analyzer
LANGFUSE_INIT_PROJECT_ID=data-analyzer
LANGFUSE_INIT_PROJECT_NAME=Data Analyzer
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=pk-lf-CHANGEME-pick-any-string
LANGFUSE_INIT_PROJECT_SECRET_KEY=sk-lf-CHANGEME-pick-any-string
LANGFUSE_INIT_USER_EMAIL=CHANGEME@example.com
LANGFUSE_INIT_USER_NAME=Admin
LANGFUSE_INIT_USER_PASSWORD=CHANGEME_langfuse_login_password

# --- Grafana ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
